@init
ext_nodenorm=1;

@slider
mode=floor(slider1+0.5);
channels=max(1,min(128,floor(slider2+0.5)));
gain=10^(slider3/20);

@sample
mode == 1 ? (
  left=0; right=0; channel=0;
  loop(channels,
    channel%2 ? right+=spl(channel) : left+=spl(channel);
    channel+=1;
  );
  spl0=left/ceil(channels/2);
  spl1=right/max(1,floor(channels/2));
);
mode == 2 ? (
  w=spl0; y=spl1;
  spl0=0.5*(w+y); spl1=0.5*(w-y);
);
mode == 3 ? (
  left=spl(max(0,min(channels-1,floor(slider4+0.5)-1)));
  right=spl(max(0,min(channels-1,floor(slider5+0.5)-1)));
  spl0=left; spl1=right;
);
// A final pass-through stage also limits the frozen output width, so internal
// Macro sidechain/output pins cannot leak into the editable Source + FX take.
channel=mode > 0 ? 2 : channels;
loop(128-channel, spl(channel)=0; channel+=1;);
channel=0;
loop(min(128,num_ch), spl(channel)*=gain; channel+=1;);
